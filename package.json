{
  "name": "prediabetes-explainer",
  "version": "3.0.0",
  "private": true,
  "description": "Prediabetes explainer video (2:00, 1920x1080, 30 fps) built with Remotion",
  "scripts": {
    "start": "remotion studio index.ts",
    "build": "remotion render index.ts PrediabetesExplainer out/PrediabetesExplainer-English.mp4 --codec=h264 --crf=16 --audio-bitrate=320k",
    "build:ar": "remotion render index.ts PrediabetesExplainerAR out/PrediabetesExplainer-Arabic.mp4 --codec=h264 --crf=16 --audio-bitrate=320k",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.544",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.544"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}